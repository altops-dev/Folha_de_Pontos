# ID da planilha (na URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
SPREADSHEET_ID=cole_o_id_da_planilha_aqui

# Caminho local do JSON baixado no Google Cloud (nunca commitar esse ficheiro)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Chave de sessão Flask (gere uma string longa e aleatória)
FLASK_SECRET_KEY=troque-por-uma-string-longa-aleatoria

# true só em desenvolvimento na sua máquina
FLASK_DEBUG=false

PORT=5000

# Utilizadores de demonstração (nome: PIN). Substitua localmente; não use dados reais no git.
USERS_JSON={"Ana":"1234","Bruno":"5678","Carla":"9012","Diego":"3456"}
